    },
    {
      "id": "el-39",
      "type": "text",
      "x": 40,
      "y": 374,
      "width": 880,
      "height": 15,
      "angle": 0,
      "strokeColor": "#1A1A1A",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 1,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "roundness": null,
      "seed": 309841,
      "version": 1,
      "versionNonce": 4085431,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1,
      "link": null,
      "locked": false,
      "text": "AdaGrad divides each step by the root of that parameter’s own accumulated g².",
      "originalText": "AdaGrad divides each step by the root of that parameter’s own accumulated g².",
      "fontSize": 12,
      "fontFamily": 5,
      "textAlign": "center",
      "verticalAlign": "top",
      "containerId": null,
      "lineHeight": 1.25,
      "autoResize": true
    },
    {
      "id": "el-40",
      "type": "text",
      "x": 40,
      "y": 398,
      "width": 880,
      "height": 13.75,
      "angle": 0,
      "strokeColor": "#5C5C5C",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 1,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "roundness": null,
      "seed": 317760,
      "version": 1,
      "versionNonce": 4190160,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1,
      "link": null,
      "locked": false,
      "text": "A gradient 100× larger accumulates a cache 10 000× larger, whose root is 100×, so the two steps come out the same size.",
      "originalText": "A gradient 100× larger accumulates a cache 10 000× larger, whose root is 100×, so the two steps come out the same size.",
      "fontSize": 11,
      "fontFamily": 5,
      "textAlign": "center",
      "verticalAlign": "top",
      "containerId": null,
      "lineHeight": 1.25,
      "autoResize": true
    },
    {
      "id": "el-41",
      "type": "text",
      "x": 40,
      "y": 444,
      "width": 772.2,
      "height": 15,
      "angle": 0,
      "strokeColor": "#5C5C5C",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 1,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "roundness": null,
      "seed": 325679,
      "version": 1,
      "versionNonce": 4294889,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1,
      "link": null,
      "locked": false,
      "text": "The hundredfold gap in the gradients cancels itself. What survives is the sign and a step α sets once for everything.",
      "originalText": "The hundredfold gap in the gradients cancels itself. What survives is the sign and a step α sets once for everything.",
      "fontSize": 12,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "lineHeight": 1.25,
