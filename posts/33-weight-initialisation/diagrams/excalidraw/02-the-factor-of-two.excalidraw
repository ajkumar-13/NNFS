      "boundElements": null,
      "updated": 1,
      "link": null,
      "locked": false,
      "text": "Glorot preserves variance for an activation that preserves variance. ReLU is not one of those.",
      "originalText": "Glorot preserves variance for an activation that preserves variance. ReLU is not one of those.",
      "fontSize": 12,
      "fontFamily": 5,
