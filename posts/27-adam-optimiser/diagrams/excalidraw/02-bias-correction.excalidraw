    {
      "id": "el-37",
      "type": "text",
      "x": 40,
      "y": 404,
      "width": 880,
      "height": 15,
      "angle": 0,
      "strokeColor": "#1A1A1A",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 1,
      "strokeStyle": "solid",
