      "frameId": null,
      "roundness": null,
      "seed": 294003,
      "version": 1,
      "versionNonce": 3875973,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1,
      "link": null,
      "locked": false,
      "text": "For a constant gradient, mₜ = (1 − β₁ᵗ) g exactly, so dividing by (1 − β₁ᵗ) recovers g exactly.",
      "originalText": "For a constant gradient, mₜ = (1 − β₁ᵗ) g exactly, so dividing by (1 − β₁ᵗ) recovers g exactly.",
      "fontSize": 12,
      "fontFamily": 5,
      "textAlign": "center",
      "verticalAlign": "top",
      "containerId": null,
      "lineHeight": 1.25,
      "autoResize": true
    },
    {
      "id": "el-38",
      "type": "text",
      "x": 40,
      "y": 428,
      "width": 880,
      "height": 13.75,
      "angle": 0,
      "strokeColor": "#5C5C5C",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 1,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "roundness": null,
      "seed": 301922,
      "version": 1,
      "versionNonce": 3980702,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1,
      "link": null,
      "locked": false,
      "text": "The correction is not a heuristic and it needs no schedule: as βᵗ → 0 the factor goes to 1 and the term disappears on its own.",
      "originalText": "The correction is not a heuristic and it needs no schedule: as βᵗ → 0 the factor goes to 1 and the term disappears on its own.",
