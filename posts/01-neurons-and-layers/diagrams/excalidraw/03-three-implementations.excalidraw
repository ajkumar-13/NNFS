      "text": "outputs = []\nfor w_row, b in zip(w, biases):\n    out = 0\n    for xi, wi in zip(x, w_row):\n        out += xi * wi\n    out += b\n    outputs.append(out)",
      "originalText": "outputs = []\nfor w_row, b in zip(w, biases):\n    out = 0\n    for xi, wi in zip(x, w_row):\n        out += xi * wi\n    out += b\n    outputs.append(out)",
