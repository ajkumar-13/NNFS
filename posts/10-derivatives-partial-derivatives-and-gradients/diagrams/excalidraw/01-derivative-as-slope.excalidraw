      "versionNonce": 4294889,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1,
      "link": null,
      "locked": false,
      "text": "When f is the loss and x is a weight, these three readings become three different things to do with that weight.",
      "originalText": "When f is the loss and x is a weight, these three readings become three different things to do with that weight.",
