      "updated": 1,
      "link": null,
      "locked": false,
      "text": "Accuracy counts how often the argmax is right. Loss measures how much probability mass sat on the right answer.",
      "originalText": "Accuracy counts how often the argmax is right. Loss measures how much probability mass sat on the right answer.",
