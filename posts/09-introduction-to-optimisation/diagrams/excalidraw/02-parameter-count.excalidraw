      "boundElements": null,
      "updated": 1,
      "link": null,
      "locked": false,
      "text": "Random search has to land in a good region by luck, and that region is a vanishing fraction of the space it is drawn from.",
      "originalText": "Random search has to land in a good region by luck, and that region is a vanishing fraction of the space it is drawn from.",
      "fontSize": 12,
      "fontFamily": 5,
      "textAlign": "center",
      "verticalAlign": "top",
      "containerId": null,
      "lineHeight": 1.25,
      "autoResize": true
    },
    {
