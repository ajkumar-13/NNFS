      "roundness": null,
      "seed": 389031,
      "version": 1,
      "versionNonce": 5132721,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1,
      "link": null,
      "locked": false,
      "text": "Doubling the number of draws does not double the odds. Knowing which way is downhill before stepping is what replaces the luck.",
      "originalText": "Doubling the number of draws does not double the odds. Knowing which way is downhill before stepping is what replaces the luck.",
      "fontSize": 11,
      "fontFamily": 5,
