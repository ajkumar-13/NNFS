      "updated": 1,
      "link": null,
      "locked": false,
      "text": "Decay lowers the loss and stops the late-training oscillation. It does not raise the accuracy.",
      "originalText": "Decay lowers the loss and stops the late-training oscillation. It does not raise the accuracy.",
