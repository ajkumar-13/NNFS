      "isDeleted": false,
      "boundElements": null,
      "updated": 1,
      "link": null,
      "locked": false,
      "text": "No mask, no rescale, no branch in the arithmetic.\nThe layer is used exactly as it is.",
      "originalText": "No mask, no rescale, no branch in the arithmetic.\nThe layer is used exactly as it is.",
