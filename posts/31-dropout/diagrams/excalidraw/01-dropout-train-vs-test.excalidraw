      "versionNonce": 7960404,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1,
      "link": null,
      "locked": false,
      "text": "Expected training output is 8 × 0.8 × 1.25 = 8, which is the evaluation output. That equality is the whole trick.",
      "originalText": "Expected training output is 8 × 0.8 × 1.25 = 8, which is the evaluation output. That equality is the whole trick.",
      "fontSize": 12,
      "fontFamily": 5,
      "textAlign": "center",
      "verticalAlign": "top",
      "containerId": null,
      "lineHeight": 1.25,
      "autoResize": true
    },
    {
      "id": "el-77",
      "type": "text",
      "x": 40,
      "y": 448,
      "width": 880,
      "height": 13.75,
      "angle": 0,
      "strokeColor": "#5C5C5C",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 1,
      "strokeStyle": "solid",
      "roughness": 1,
