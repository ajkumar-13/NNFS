      "version": 1,
      "versionNonce": 8065133,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1,
      "link": null,
      "locked": false,
      "text": "Vanilla dropout instead scales at test time. Inverted dropout puts the cost in training, where it is already being paid.",
      "originalText": "Vanilla dropout instead scales at test time. Inverted dropout puts the cost in training, where it is already being paid.",
      "fontSize": 11,
      "fontFamily": 5,
      "textAlign": "center",
      "verticalAlign": "top",
      "containerId": null,
      "lineHeight": 1.25,
      "autoResize": true
