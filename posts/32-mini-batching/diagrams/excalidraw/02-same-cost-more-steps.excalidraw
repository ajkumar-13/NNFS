      "versionNonce": 11311732,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1,
      "link": null,
      "locked": false,
      "text": "Nothing in any optimiser class changes. Only the training loop gains an inner loop over batches.",
      "originalText": "Nothing in any optimiser class changes. Only the training loop gains an inner loop over batches.",
