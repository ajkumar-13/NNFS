    },
    {
      "id": "el-106",
      "type": "text",
      "x": 40,
      "y": 378,
      "width": 880,
      "height": 15,
      "angle": 0,
      "strokeColor": "#1A1A1A",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 1,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "roundness": null,
      "seed": 840414,
      "version": 1,
      "versionNonce": 11102274,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1,
      "link": null,
      "locked": false,
      "text": "A batch gradient averages B per-sample gradients, so its variance falls as 1/B and its noise as 1/√B.",
      "originalText": "A batch gradient averages B per-sample gradients, so its variance falls as 1/B and its noise as 1/√B.",
      "fontSize": 12,
      "fontFamily": 5,
      "textAlign": "center",
      "verticalAlign": "top",
      "containerId": null,
      "lineHeight": 1.25,
      "autoResize": true
    },
    {
      "id": "el-107",
      "type": "text",
      "x": 40,
      "y": 402,
      "width": 880,
      "height": 13.75,
      "angle": 0,
      "strokeColor": "#5C5C5C",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 1,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "roundness": null,
      "seed": 848333,
      "version": 1,
      "versionNonce": 11207003,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1,
      "link": null,
      "locked": false,
      "text": "Going from B = 1 to B = 128 cuts the noise by a factor of about eleven and still leaves 469 steps per epoch instead of one.",
      "originalText": "Going from B = 1 to B = 128 cuts the noise by a factor of about eleven and still leaves 469 steps per epoch instead of one.",
      "fontSize": 11,
      "fontFamily": 5,
      "textAlign": "center",
      "verticalAlign": "top",
      "containerId": null,
      "lineHeight": 1.25,
      "autoResize": true
    },
    {
      "id": "el-108",
      "type": "text",
      "x": 40,
      "y": 444,
      "width": 633.6,
      "height": 15,
      "angle": 0,
      "strokeColor": "#5C5C5C",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 1,
