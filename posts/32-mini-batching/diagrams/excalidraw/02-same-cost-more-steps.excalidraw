      "versionNonce": 10892816,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1,
      "link": null,
      "locked": false,
      "text": "Every step is a single sample,\nso every direction is a very\nhigh-variance guess.",
      "originalText": "Every step is a single sample,\nso every direction is a very\nhigh-variance guess.",
      "fontSize": 10,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "lineHeight": 1.25,
      "autoResize": true
    },
    {
