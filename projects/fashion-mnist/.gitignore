# Environment and tool output
.venv/
__pycache__/
*.py[cod]
.pytest_cache/
.ruff_cache/
.coverage
.coverage.*
htmlcov/

# The dataset is fetched by scripts/download_fashion_mnist.py and never committed
fashion_mnist_cache/
*.gz

